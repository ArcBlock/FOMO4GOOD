{
	"name": "fomo4good-gateway",
	"main": "../dist/worker/gateway.mjs",
	"compatibility_date": "2026-09-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"FOMO_ORIGIN": "https://REPLACE_WITH_PUBLIC_HOST"
	},
	"services": [
		{
			"binding": "FOMO_PROVIDER",
			"service": "fomo4good-provider"
		}
	],
	"ratelimits": [
		{
			"name": "FOMO_RATE_LIMITER",
			"namespace_id": "4931",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	"routes": [
		{
			"pattern": "REPLACE_WITH_PUBLIC_HOST/api/*",
			"zone_name": "REPLACE_WITH_ZONE"
		}
	]
}
