# Preview runs locally without a wallet. npm run dev sets this automatically.
FOMO_MODE=preview
PORT=4931
FOMO_ORIGIN=http://localhost:4931
FOMO_ARC_URL=http://127.0.0.1:4930
# ARC_HOME defaults to ../arc. The checkout must have built dist artifacts.
# ARC_HOME=/Users/you/work/arcblock/arc

# To use the real watcher, choose testnet and fill every field below.
# Only test USDC; this profile never claims to collect real donations.
# FOMO_MODE=testnet
# FOMO_RPC_URL=https://rpc.testnet.arc.io
# FOMO_RECIPIENT=0x... YOUR DEDICATED CAMPAIGN RECEIVING ADDRESS
# FOMO_OWNER_DID=did:abt:YOUR_INSTALLER_DID
# FOMO_INSTANCE_DID=did:abt:YOUR_CAMPAIGN_INSTANCE_DID
# FOMO_START_BLOCK=... first monitored block, after the Zero5 event transition
# FOMO_STARTS_AT=2026-... ISO timestamp with explicit timezone
# FOMO_ENDS_AT=2026-... ISO timestamp with explicit timezone
# FOMO_SPACE_ROOT=/absolute/path/to/operator/did-spaces
